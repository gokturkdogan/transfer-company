# Server-only
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
LOG_LEVEL=info

# Cloudinary (vehicle image uploads)
CLOUDINARY_CLOUD_NAME=pdyhhkjq
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gmail SMTP (optional — reservation emails; all four required when enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-google-app-password
# Optional overrides (Gmail: SMTP_FROM_EMAIL must match SMTP_USER or a verified alias)
SMTP_FROM_NAME=VIP Transfer
# SMTP_FROM_EMAIL=you@gmail.com
ADMIN_NOTIFICATION_EMAIL=ops@example.com
TEST_NOTIFICATION_EMAIL=you@gmail.com

# Build/CI escape hatch — never use in production
SKIP_ENV_VALIDATION=false

# Client-safe (NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_URL=http://localhost:3000
